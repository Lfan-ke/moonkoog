// Retrieval-augmented generation storage — Koog `rag-vector`. The in-memory vector store and the
// cosine-similarity ranking that turns a query embedding into the most relevant documents.
supported_targets = "native"

import {
  "Lfan-ke/moonkoog/embeddings",
}

// The async runtime backs the `async test` that drives embed-on-add / embed-on-search.
import {
  "Lfan-ke/moonkoog/embeddings",
  "moonbitlang/async",
} for "test"
