// The agent core — Koog 1.1.1 `agents-core` + the `prompt-executor-clients`
// contract. Native (the LLM client is async): the LLMClient trait, a scripted
// MockClient for deterministic tests, the AIAgent, and its singleRunStrategy
// tool-calling loop. The async runtime (moonbitlang/async) is a library
// dependency: the strategy graph's parallel node runs its branches through it.
supported_targets = "native"

import {
  "Lfan-ke/moonkoog/prompt",
  "Lfan-ke/moonkoog/llm",
  "Lfan-ke/moonkoog/tools",
  "Lfan-ke/moonkoog/persistence",
  "moonbitlang/async",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
}

import {
  "Lfan-ke/moonkoog/prompt",
  "Lfan-ke/moonkoog/llm",
  "Lfan-ke/moonkoog/tools",
  "Lfan-ke/moonkoog/persistence",
  "moonbitlang/async",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
} for "test"
