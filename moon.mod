name = "Lfan-ke/moonkoog"

version = "0.3.1"

readme = "README.md"

repository = "https://github.com/Lfan-ke/moonkoog"

license = "Apache-2.0"

keywords = [ "koog", "agent", "llm", "tool-calling", "moonbit" ]

description = "moonkoog — a MoonBit port of JetBrains Koog (1.1.1): a type-safe agent-orchestration framework. The prompt/message model, LLM client contract, tool registry with a JSON-schema descriptor model, and the AIAgent tool-calling loop (Koog's singleRunStrategy), built to compose with the moon-heke full-stack suite."

import {
  "moonbitlang/async@0.20.3",
  "DC-Z-lab/moonllm@0.1.0",
}
